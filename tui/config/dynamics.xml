<tui on_visit="mt_visit_dynamics">
  <script src="mt_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" border="none">
    <pane id="st" split="h" weight="10" max_height="1" border="none" class="bar">
      <pane id="st_main" weight="72" border="none" class="bar" hpad="1"/>
      <pane id="st_busy" weight="28" border="none" class="bar" hpad="1"/>
    </pane>
    <pane id="body" split="h" weight="90" border="none">
      <pane id="nav" weight="13" strict_fit="false" title="Dynamics" border="single" class="nav"/>
      <pane id="main" split="h" weight="87" border="none">
        <pane id="dy_left"  weight="50" title="Within a session" border="single" class="panel" hpad="1" scroll="v"/>
        <pane id="dy_right" weight="50" title="Relationships"    border="single" class="panel" hpad="1" scroll="v"/>
      </pane>
    </pane>
  </pane>

  <include src="_chrome.xml"/>

</tui>
