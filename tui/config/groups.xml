<tui on_visit="mt_visit_groups">
  <script src="mt_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" border="none">
    <pane id="st" split="h" weight="10" max_height="1" border="none" class="bar">
      <pane id="st_main" weight="72" border="none" class="bar" hpad="1"/>
      <pane id="st_busy" weight="28" border="none" class="bar" hpad="1"/>
    </pane>
    <pane id="body" split="h" weight="90" border="none">
      <pane id="nav" weight="13" strict_fit="false" title="Groups" border="single" class="nav"/>
      <pane id="main" split="v" weight="87" border="none">
        <pane id="gr_ctl" split="grid" rows="1" cols="2" col_weights="3 1" weight="10" max_height="1" border="none" class="toolbar">
          <pane id="gr_c1" border="none" hpad="1" class="toolbar"/>
          <pane id="gr_c2" border="none" hpad="1" class="toolbar"/>
        </pane>
        <pane id="gr_tab"  weight="7"  title="Groups (reference = first row)" border="single" class="panel" hpad="1"/>
        <pane id="gr_plot" weight="13" title="Distribution and adjusted effects" border="single" class="panel" hpad="1" scroll="v"/>
      </pane>
    </pane>
  </pane>

  <include src="_chrome.xml"/>
  <select id="gr_factor" pane="gr_c1" row="0" label="Group by:" items="Tag combo" action="mt_groups_factor"/>
  <button id="gr_label"  pane="gr_c2" row="0" text="[ Label selected group ]" action="mt_groups_label" class="info_button" align="fill"/>
  <table  id="gr_table"  pane="gr_tab" row="0" rows="0" columns="Group" action="mt_groups_label"/>
</tui>
